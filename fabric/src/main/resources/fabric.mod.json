{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "lekavar.lma.drinkbeer.fabric.FabricDrinkBeer"
    ],
    "client": [
      "lekavar.lma.drinkbeer.fabric.client.FabricDrinkBeerClient"
    ],
    "jei_mod_plugin": [
      "lekavar.lma.drinkbeer.compat.jei.Plugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}"
  }
}
